<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Taken from the .NET that is installed, rather than written out, so
         this keeps naming the right one as .NET is updated. Microsoft.NET.Sdk
         sets NETCoreSdkVersion before this group is read. -->
    <TargetFramework>net$([System.Version]::Parse($(NETCoreSdkVersion)).Major).0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version="*" floats each package to its newest release whenever the
         image is built. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="*" />
    <PackageReference Include="Reqnroll.NUnit" Version="*" />
    <PackageReference Include="nunit" Version="*" />
    <PackageReference Include="NUnit3TestAdapter" Version="*" />
  </ItemGroup>

</Project>
